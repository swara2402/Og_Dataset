{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic terminology entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["term_id", "term", "definition", "disciplines", "contexts", "preferred_form", "avoid_substitutions", "usage_note", "source", "review_status"],
  "properties": {
    "term_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "term": {"type": "string", "minLength": 1, "maxLength": 240},
    "definition": {"type": "string", "minLength": 1, "maxLength": 3000},
    "disciplines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "contexts": {"type": "array", "items": {"type": "string"}},
    "preferred_form": {"type": "string", "minLength": 1},
    "avoid_substitutions": {"type": "array", "items": {"type": "string"}},
    "usage_note": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "license", "attribution"],
      "properties": {
        "kind": {"enum": ["expert_curated", "licensed_corpus", "public_dataset", "synthetic"]},
        "reference": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "attribution": {"type": "string"}
      }
    },
    "review_status": {"enum": ["draft", "reviewed", "rejected"]},
    "reviewer_id": {"type": ["string", "null"]}
  },
  "allOf": [{
    "if": {"properties": {"review_status": {"const": "reviewed"}}},
    "then": {"properties": {"reviewer_id": {"type": "string", "minLength": 1}}}
  }]
}
