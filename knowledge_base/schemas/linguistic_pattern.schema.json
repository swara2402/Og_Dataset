{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discipline- and section-aware linguistic pattern",
  "type": "object",
  "additionalProperties": false,
  "required": ["pattern_id", "discipline", "section", "pattern_name", "structural_template", "functional_role", "usage_context", "avoid_when", "source", "review_status"],
  "properties": {
    "pattern_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "discipline": {"type": "string", "minLength": 1},
    "section": {"enum": ["abstract", "introduction", "literature_review", "methods", "results", "discussion", "conclusion", "other"]},
    "pattern_name": {"type": "string", "minLength": 1},
    "structural_template": {"type": "string", "minLength": 1, "maxLength": 2000},
    "functional_role": {"type": "string", "minLength": 1, "maxLength": 1000},
    "usage_context": {"type": "string", "minLength": 1, "maxLength": 2000},
    "avoid_when": {"type": "array", "items": {"type": "string"}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "license", "attribution"],
      "properties": {
        "kind": {"enum": ["expert_curated", "licensed_corpus", "public_dataset", "synthetic"]},
        "reference": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "attribution": {"type": "string"}
      }
    },
    "review_status": {"enum": ["draft", "reviewed", "rejected"]},
    "reviewer_id": {"type": ["string", "null"]}
  },
  "allOf": [{
    "if": {"properties": {"review_status": {"const": "reviewed"}}},
    "then": {"properties": {"reviewer_id": {"type": "string", "minLength": 1}}}
  }]
}
