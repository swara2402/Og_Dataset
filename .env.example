# OPTIONAL OFFLINE NLP (disabled unless explicitly enabled)
SPACY_ENABLED=false
SPACY_MODEL=en_core_web_sm


# PROCESSING
TURNITOUT_BATCH_SIZE=4
TURNITOUT_MAX_WORKERS=2
TURNITOUT_MAX_RETRIES=2
TURNITOUT_MAX_PASSES=1
TURNITOUT_MAX_PARAGRAPH_CHARS=4500
TURNITOUT_MIN_PARAGRAPH_CHARS=40
CACHE_MAX_SIZE=1000
MAX_FILE_SIZE_MB=25

# ORIGINALITY (explicit user action only)
ENABLE_WEB_ORIGINALITY=false
WEB_TIMEOUT=12
WEB_MAX_QUERIES=6
WEB_PAGES_PER_QUERY=2

# API AUTHENTICATION (optional for trusted localhost use; required for deployments)
# Map stable user IDs to unique random bearer secrets (minimum 32 characters).
# OG_API_TOKENS={"alice":"replace-with-a-random-secret-of-32-characters-minimum"}
# Set true for deployments; requests fail closed if tokens are not configured.
OG_API_AUTH_REQUIRED=false
# Optional administrator user IDs; required for token users to change global settings/clear cache.
# OG_API_ADMIN_USERS=alice

# LOCAL STORAGE / CORS
UPLOAD_DIR=backend/uploads
EXPORT_DIR=backend/exports
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DEBUG=false

# Per-owner + direct-client-IP request budget (per process, per 60-second window).
OG_API_RATE_LIMIT_PER_MINUTE=120
