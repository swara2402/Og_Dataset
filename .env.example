# OPTIONAL LOCAL NLP / LLM (disabled unless explicitly enabled)
SPACY_ENABLED=false
SPACY_MODEL=en_core_web_sm
OLLAMA_ENABLED=false

# LOCAL OLLAMA
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TEMPERATURE=0.35
AUTO_WARMUP=true
# Leave OLLAMA_API_KEY empty for local Ollama.

# PROCESSING
TURNITOUT_BATCH_SIZE=4
TURNITOUT_MAX_WORKERS=2
TURNITOUT_MAX_RETRIES=2
TURNITOUT_MAX_PASSES=1
TURNITOUT_MAX_PARAGRAPH_CHARS=4500
TURNITOUT_MIN_PARAGRAPH_CHARS=40
CACHE_MAX_SIZE=1000
MAX_FILE_SIZE_MB=25

# ORIGINALITY (explicit user action only)
ENABLE_WEB_ORIGINALITY=true
WEB_TIMEOUT=12
WEB_MAX_QUERIES=6
WEB_PAGES_PER_QUERY=2

# LOCAL STORAGE / CORS
UPLOAD_DIR=backend/uploads
EXPORT_DIR=backend/exports
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DEBUG=true

# HOSTED TURNITOUT BACKEND (optional):
# Point to the HTTPS URL of hosted_gateway.py, not the user's localhost.
# OLLAMA_BASE_URL=https://your-private-model-gateway.example.com
# OLLAMA_API_KEY=the-same-secret-as-TURNITOUT_GATEWAY_API_KEY
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# OLLAMA_KEEP_ALIVE=10m
