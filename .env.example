# DATASET
# Optional external dataset checkout. Leave blank to use the tracked repository files.
# OG_DATASET_DIR=

# PROCESSING
RULE_ENGINE_ENABLED=true
RULE_VERBOSE_LOGGING=false
TURNITOUT_BATCH_SIZE=8
TURNITOUT_MAX_WORKERS=1
TURNITOUT_MAX_RETRIES=0
TURNITOUT_MAX_PASSES=1
TURNITOUT_MAX_PARAGRAPH_CHARS=0
TURNITOUT_MIN_PARAGRAPH_CHARS=1
CACHE_MAX_SIZE=1000
MAX_FILE_SIZE_MB=25

# ORIGINALITY (only used after an explicit user action)
ENABLE_WEB_ORIGINALITY=true
WEB_TIMEOUT=12
WEB_MAX_QUERIES=6
WEB_PAGES_PER_QUERY=2

# STORAGE AND CORS
UPLOAD_DIR=backend/uploads
EXPORT_DIR=backend/exports
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DEBUG=false
